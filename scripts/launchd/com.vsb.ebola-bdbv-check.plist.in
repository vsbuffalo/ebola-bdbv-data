<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for `make cron-install`: @REPO@ is substituted with the
     repository's absolute path at install time, so no absolute path is
     committed. Runs scripts/cron_check.sh every six hours. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vsb.ebola-bdbv-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>@REPO@/scripts/cron_check.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@REPO@/logs/launchd_check.log</string>
  <key>StandardErrorPath</key>
  <string>@REPO@/logs/launchd_check.log</string>
</dict>
</plist>
